#!/bin/sh
set -eu
[ "$$" -eq 1 ] || exit 1
export PATH=/bin:/usr/bin:/lab
export PYTHONUNBUFFERED=1
/bin/busybox mount -t devtmpfs none /dev
exec >/dev/console 2>&1
/bin/busybox mount -t proc none /proc
/bin/busybox mount -t sysfs none /sys
/bin/busybox mkdir -p /dev/pts
/bin/busybox mount -t devpts none /dev/pts
/bin/busybox insmod /lab/modules/crc16.ko
/bin/busybox insmod /lab/modules/ax25.ko
/bin/busybox insmod /lab/modules/mkiss.ko
/bin/busybox ip link set up dev lo
/bin/busybox syslogd -O /dev/console -s 0
cd /lab
if /usr/bin/python3 -B -S /lab/case.py; then
    echo "FCMS AX25 PASS $fcms_case"
else
    echo "FCMS AX25 FAIL $fcms_case"
fi
/bin/busybox poweroff -f
