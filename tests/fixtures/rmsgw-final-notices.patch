--- a/rmsgw/session.c
+++ b/rmsgw/session.c
@@ -42,0 +43 @@ static char svnid[] = "$Id: session.c 179 2014-10-30 10:59:18Z eckertb $";
+#include <signal.h>
@@ -50,0 +52,31 @@ extern char *active_configfile;
+/* Suppress only SIGPIPE generated by a session's final optional notices.
+ * Preserve a pre-existing pending signal and the caller's signal mask. */
+static int send_final_notice(int fd, char *buffer, int len)
+{
+     sigset_t set, old, pending;
+     struct timespec zero = {0, 0};
+     int rc, saved_errno, was_pending, was_blocked;
+
+     sigemptyset(&set);
+     sigaddset(&set, SIGPIPE);
+     if (sigprocmask(SIG_BLOCK, &set, &old) < 0)
+          return -1;
+     if (sigpending(&pending) < 0) {
+          saved_errno = errno;
+          sigprocmask(SIG_SETMASK, &old, NULL);
+          errno = saved_errno;
+          return -1;
+     }
+     was_pending = sigismember(&pending, SIGPIPE);
+     was_blocked = sigismember(&old, SIGPIPE);
+     rc = sendrf(fd, buffer, len, SRF_EOLXLATE);
+     saved_errno = errno;
+     if (rc < 0 && saved_errno == EPIPE && !was_pending && !was_blocked) {
+          while (sigtimedwait(&set, NULL, &zero) < 0 && errno == EINTR)
+               ;
+     }
+     sigprocmask(SIG_SETMASK, &old, NULL);
+     errno = saved_errno;
+     return rc;
+}
+
@@ -180 +212 @@ int cmsSession(cmsnode *the_cms, config *cfg, char *ax25port, char *usercall)
-	  sendrf(STDOUT_FILENO, buffer, strlen(buffer), SRF_EOLXLATE);
+	  send_final_notice(STDOUT_FILENO, buffer, strlen(buffer));
@@ -183 +215 @@ int cmsSession(cmsnode *the_cms, config *cfg, char *ax25port, char *usercall)
-	  sendrf(STDOUT_FILENO, buffer, strlen(buffer), SRF_EOLXLATE);
+	  send_final_notice(STDOUT_FILENO, buffer, strlen(buffer));
