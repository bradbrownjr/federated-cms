# Copy to ~/.local/share/fcms-lab/lab.env and fill in. Not committed.
FCMS_LAB_ACCOUNT=N0CALL
FCMS_B2F_PORT=63191
# TCP KISS port of the sound modem or TNC
FCMS_KISS_HOST=192.0.2.10
FCMS_KISS_PORT=8001
# This station's AX.25 address, and the one client station the bridge answers
FCMS_STATION=N0CALL-10
FCMS_PEER=N0CALL
# Seconds between update checks is set in fcms-update.timer
